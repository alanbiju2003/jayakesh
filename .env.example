# =====================================================================
# JAYAKESH KERALA HAIR OIL — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local use, or add these in Vercel -> Settings -> Environment Variables
# =====================================================================

# Server Port (for local/VPS run; Vercel manages ports automatically)
PORT=3000

# Public Website Domain (set to your GoDaddy domain once live, e.g. https://jayakesh.com)
PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# ADMIN SECURITY (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@jayakesh.com
ADMIN_PASSWORD=Jayakesh@Admin2026
ADMIN_SECRET=jayakesh-super-secret-signing-key-change-in-prod-2026

# ---------------------------------------------------------------------
# CLOUD DATABASE (24/7 FREE ON VERCEL VIA NEON / SUPABASE POSTGRES)
# Leave blank locally to automatically use local SQLite (./data/jayakesh.db).
# In Vercel: Storage -> Create Database -> Neon Postgres (auto-sets DATABASE_URL / POSTGRES_URL)
# ---------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------
# EMAIL NOTIFICATIONS — OPTION A: FREE GMAIL SMTP (500 emails/day free)
# 1. Turn on 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords -> Generate 16-char App Password
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------
# EMAIL NOTIFICATIONS — OPTION B: CUSTOM GODADDY DOMAIN EMAIL (Resend Free 3,000/mo)
# Sign up free at https://resend.com -> Verify your GoDaddy domain -> Create API Key
# ---------------------------------------------------------------------
RESEND_API_KEY=

# Sender address & Owner notification recipient
EMAIL_FROM=Jayakesh Kerala Hair Oil <orders@jayakesh.com>
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------
# OPTIONAL INSTANT MOBILE PUSH ALERTS (FREE TELEGRAM BOT OR WEBHOOK)
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

